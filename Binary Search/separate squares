class Solution:
    def separateSquares(self, squares: List[List[int]]) -> float:
        total_area = 0
        min_y = float('inf')
        max_y = float('-inf')

        for x, y, l in squares:
            total_area += l * l
            min_y = min(min_y, y)
            max_y = max(max_y, y + l)  

        target = total_area / 2

        def area_above(h):
            area = 0
            for x, y, l in squares:
                if h <= y:
                    area += l * l
                elif h >= y + l:
                    continue
                else:
                    area += (y + l - h) * l
            return area

        low, high = min_y, max_y
        eps = 1e-6

        while high - low > eps:
            mid = (low + high) / 2
            if area_above(mid) > target:
                low = mid
            else:
                high = mid

        return (low + high) / 2
